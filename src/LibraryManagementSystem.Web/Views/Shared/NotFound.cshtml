@{
    ViewData["Title"] = "Not Found";
}

<div class="container-fluid d-flex align-items-center justify-content-center" style="min-height: 70vh;">
    <div class="text-center">
        <h1 class="display-1 text-warning">404</h1>
        <h1 class="h3 mb-3 text-gray-800">Page Not Found</h1>
        <p class="mb-4 text-muted">The page you are looking for might have been removed, had its name changed, or is temporarily unavailable.</p>
        <a href="/Dashboard" class="btn btn-primary"><i class="fas fa-home me-1"></i> Back to Dashboard</a>
    </div>
</div>