@model LibraryManagementSystem.Web.ViewModels.Loan.LoanListViewModel
@using LibraryManagementSystem.Domain.Enums
@{
    ViewData["Title"] = "Loan History";
}

<div class="container-fluid">
    <h1 class="h3 mb-4 text-gray-800">Loan History</h1>

    <div class="card shadow mb-4">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered table-hover" width="100%" cellspacing="0">
                    <thead class="thead-light">
                        <tr>
                            <th>Book Title</th>
                            <th>Member</th>
                            <th>Issue Date</th>
                            <th>Due Date</th>
                            <th>Return Date</th>
                            <th>Status</th>
                            <th>Fine</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Loans.Any())
                        {
                            <tr>
                                <td colspan="7" class="text-center text-muted py-4">No loan history found.</td>
                            </tr>
                        }
                        else
                        {
                            foreach (var loan in Model.Loans)
                            {
                                <tr>
                                    <td>@loan.BookTitle</td>
                                    <td>@loan.MemberName</td>
                                    <td>@loan.IssueDate.ToString("yyyy-MM-dd")</td>
                                    <td>@loan.DueDate.ToString("yyyy-MM-dd")</td>
                                    <td>@(loan.ReturnDate.HasValue ? loan.ReturnDate.Value.ToString("yyyy-MM-dd") : "N/A")</td>
                                    <td>
                                        @switch (loan.Status)
                                        {
                                            case LoanStatus.Returned:
                                                <span class="badge bg-primary">@loan.Status</span>
                                                break;
                                            case LoanStatus.Issued:
                                                <span class="badge bg-success">@loan.Status</span>
                                                break;
                                            default:
                                                <span class="badge bg-warning text-dark">@loan.Status</span>
                                                break;
                                        }
                                    </td>
                                    <td>@(loan.FineAmount > 0 ? loan.FineAmount.ToString("C") : "None")</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>