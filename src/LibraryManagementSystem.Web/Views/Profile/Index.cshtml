@model LibraryManagementSystem.Web.ViewModels.Profile.ProfileViewModel
@{
    ViewData["Title"] = "My Profile";
}

<div class="container-fluid">
    <h1 class="h3 mb-4 text-gray-800">My Profile</h1>

    <div class="row">
        <div class="col-md-4 mb-4">
            <div class="card shadow text-center">
                <div class="card-body p-4">
                    <img src="@(Model.ProfileImageUrl ?? $"https://ui-avatars.com/api/?name={Model.FirstName}+{Model.LastName}&background=3498db&color=fff")" 
                         class="rounded-circle mb-3 shadow" width="120" height="120" alt="User Avatar">
                    <h4 class="card-title mb-0">@Model.FirstName @Model.LastName</h4>
                    <p class="text-muted">@Model.Email</p>
                    @* <div class="d-grid gap-2">
                        <a href="#" class="btn btn-outline-primary btn-sm"><i class="fas fa-edit me-1"></i> Edit Profile</a>
                        <a href="#" class="btn btn-outline-warning btn-sm"><i class="fas fa-key me-1"></i> Change Password</a>
                    </div> *@
                </div>
            </div>
        </div>

        <div class="col-md-8 mb-4">
            <div class="card shadow">
                <div class="card-header bg-light py-3">
                    <h6 class="m-0 font-weight-bold text-primary"><i class="fas fa-info-circle me-2"></i> Account Details</h6>
                </div>
                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-sm-4 text-muted">First Name:</div>
                        <div class="col-sm-8"><strong>@Model.FirstName</strong></div>
                    </div>
                    <hr>
                    <div class="row mb-3">
                        <div class="col-sm-4 text-muted">Last Name:</div>
                        <div class="col-sm-8"><strong>@Model.LastName</strong></div>
                    </div>
                    <hr>
                    <div class="row mb-3">
                        <div class="col-sm-4 text-muted">Email:</div>
                        <div class="col-sm-8"><strong>@Model.Email</strong></div>
                    </div>
                    <hr>
                    <div class="row mb-3">
                        <div class="col-sm-4 text-muted">Phone:</div>
                        <div class="col-sm-8"><strong>@(Model.PhoneNumber ?? "Not provided")</strong></div>
                    </div>
                    <hr>
                    <div class="row mb-3">
                        <div class="col-sm-4 text-muted">Member Since:</div>
                        <div class="col-sm-8"><strong>@Model.CreatedAt.ToString("MMMM dd, yyyy")</strong></div>
                    </div>
                    <hr>
                    <div class="row mb-3">
                        <div class="col-sm-4 text-muted">Last Login:</div>
                        <div class="col-sm-8"><strong>@(Model.LastLoginAt.HasValue ? Model.LastLoginAt.Value.ToString("MMMM dd, yyyy HH:mm") : "N/A")</strong></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>