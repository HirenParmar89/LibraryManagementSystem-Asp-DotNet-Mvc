@model LibraryManagementSystem.Web.ViewModels.Book.BookDetailsViewModel
@{
    ViewData["Title"] = "Book Details";
}

<div class="container-fluid">
    <h1 class="h3 mb-4 text-gray-800">Book Details</h1>

    <div class="card shadow mb-4">
        <div class="card-body">
            <div class="row">
                <div class="col-md-8">
                    <h4 class="card-title mb-3">@Model.Book.Title</h4>
                    <p class="text-muted">@Model.Book.Subtitle</p>
                    
                    <hr />
                    
                    <div class="row mb-2">
                        <div class="col-sm-3"><strong>ISBN:</strong></div>
                        <div class="col-sm-9">@Model.Book.ISBN</div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-sm-3"><strong>Author:</strong></div>
                        <div class="col-sm-9">@Model.Book.AuthorName</div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-sm-3"><strong>Category:</strong></div>
                        <div class="col-sm-9">@Model.Book.CategoryName</div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-sm-3"><strong>Publisher:</strong></div>
                        <div class="col-sm-9">@Model.Book.PublisherName</div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-sm-3"><strong>Availability:</strong></div>
                        <div class="col-sm-9">
                            <span class="badge bg-success">@Model.Book.AvailableCopies Available</span>
                            <span class="badge bg-info text-dark">@Model.Book.TotalCopies Total</span>
                        </div>
                    </div>
                </div>
                <div class="col-md-4 text-center">
                    <img src="https://via.placeholder.com/200x300?text=No+Cover" class="img-fluid rounded shadow-sm" alt="Book Cover" style="max-height: 300px;">
                </div>
            </div>
        </div>
        <div class="card-footer">
            <a asp-action="Edit" asp-route-id="@Model.Book.Id" class="btn btn-warning"><i class="fas fa-edit me-1"></i> Edit</a>
            <a asp-action="Index" class="btn btn-secondary">Back to List</a>
        </div>
    </div>
</div>