@model LibraryManagementSystem.Web.ViewModels.Member.MemberDetailsViewModel
@{
    ViewData["Title"] = "Member Details";
}

<div class="container-fluid">
    <h1 class="h3 mb-4 text-gray-800">Member Details</h1>

    <div class="card shadow mb-4">
        <div class="card-body">
            <h4 class="card-title mb-3">@Model.Member.FirstName @Model.Member.LastName</h4>
            <hr />
            
            <div class="row mb-2">
                <div class="col-sm-3"><strong>Membership No:</strong></div>
                <div class="col-sm-9">@Model.Member.MembershipNumber</div>
            </div>
            <div class="row mb-2">
                <div class="col-sm-3"><strong>Email:</strong></div>
                <div class="col-sm-9">@Model.Member.Email</div>
            </div>
            <div class="row mb-2">
                <div class="col-sm-3"><strong>Type:</strong></div>
                <div class="col-sm-9">@Model.Member.MembershipType</div>
            </div>
            <div class="row mb-2">
                <div class="col-sm-3"><strong>Status:</strong></div>
                <div class="col-sm-9">
                    @if (Model.Member.IsActive)
                    {
                        <span class="badge bg-success">Active</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">Inactive</span>
                    }
                </div>
            </div>
        </div>
        <div class="card-footer">
            <a asp-action="Edit" asp-route-id="@Model.Member.Id" class="btn btn-warning"><i class="fas fa-edit me-1"></i> Edit</a>
            <a asp-action="Index" class="btn btn-secondary">Back to List</a>
        </div>
    </div>
</div>