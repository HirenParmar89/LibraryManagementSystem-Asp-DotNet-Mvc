@model IEnumerable<LibraryManagementSystem.Application.DTOs.InventoryReportDto>
@{
    ViewData["Title"] = "Inventory Report";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0 text-gray-800">Inventory Report</h1>
        <div class="d-flex gap-2">
            <button onclick="window.print()" class="btn btn-outline-secondary"><i class="fas fa-print"></i> Print</button>
            <a asp-action="ExportInventory" class="btn btn-success"><i class="fas fa-file-excel"></i> Export Excel</a>
        </div>
    </div>

    <div class="card shadow mb-4">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered table-hover" width="100%" cellspacing="0">
                    <thead class="thead-light">
                        <tr>
                            <th>ISBN</th>
                            <th>Title</th>
                            <th>Author</th>
                            <th>Category</th>
                            <th>Total Copies</th>
                            <th>Available</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr><td colspan="6" class="text-center text-muted py-4">No inventory data found.</td></tr>
                        }
                        else
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.ISBN</td>
                                    <td>@item.Title</td>
                                    <td>@item.Author</td>
                                    <td>@item.Category</td>
                                    <td>@item.TotalCopies</td>
                                    <td>@item.AvailableCopies</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>