@model IEnumerable<Microsoft.AspNetCore.Identity.IdentityRole>
@{
    ViewData["Title"] = "Assign Role";
}

<div class="container-fluid">
    <h1 class="h3 mb-4 text-gray-800">Assign Role to @ViewBag.UserEmail</h1>

    <div class="card shadow mb-4">
        <div class="card-body">
            <form asp-action="AssignRole" method="post">
                <input type="hidden" name="userId" value="@ViewBag.UserId" />
                
                <div class="mb-3">
                    <label class="form-label">Select Role</label>
                    <select name="role" class="form-select" required>
                        <option value="None">-- Select Role --</option>
                        @foreach (var role in Model)
                        {
                            if (ViewBag.UserRoles.Contains(role.Name))
                            {
                                <option value="@role.Name" selected>@role.Name (Current)</option>
                            }
                            else
                            {
                                <option value="@role.Name">@role.Name</option>
                            }
                        }
                    </select>
                </div>

                <div class="d-flex justify-content-end">
                    <a asp-action="Index" class="btn btn-secondary me-2">Cancel</a>
                    <button type="submit" class="btn btn-primary"><i class="fas fa-save me-1"></i> Update Role</button>
                </div>
            </form>
        </div>
    </div>
</div>