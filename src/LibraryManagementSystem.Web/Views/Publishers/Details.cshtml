@model LibraryManagementSystem.Web.ViewModels.Publisher.PublisherDetailsViewModel
@{
    ViewData["Title"] = "Publisher Details";
}

<div class="container-fluid">
    <h1 class="h3 mb-4 text-gray-800">Publisher Details</h1>

    <div class="card shadow mb-4">
        <div class="card-body">
            <h4 class="card-title mb-3">@Model.Publisher.Name</h4>
            <hr />
            
            <div class="row mb-2">
                <div class="col-sm-3"><strong>Publisher ID:</strong></div>
                <div class="col-sm-9">@Model.Publisher.Id</div>
            </div>
        </div>
        <div class="card-footer">
            <a asp-action="Edit" asp-route-id="@Model.Publisher.Id" class="btn btn-warning"><i class="fas fa-edit me-1"></i> Edit</a>
            <a asp-action="Index" class="btn btn-secondary">Back to List</a>
        </div>
    </div>
</div>