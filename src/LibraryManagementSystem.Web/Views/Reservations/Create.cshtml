@model LibraryManagementSystem.Web.ViewModels.Reservation.CreateReservationViewModel
@using LibraryManagementSystem.Application.DTOs
@{
    ViewData["Title"] = "Create Reservation";
}

<div class="container-fluid">
    <h1 class="h3 mb-4 text-gray-800">Create Reservation</h1>

    <div class="card shadow mb-4">
        <div class="card-body">
            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                
                <div class="mb-3">
                    <label class="form-label">Select Book to Reserve</label>
                    <select asp-for="BookId" class="form-select" asp-items="@(new SelectList(Model.Books, "Id", "Title"))">
                        <option value="">-- Select Book --</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label">Select Member</label>
                    <select asp-for="MemberId" class="form-select" asp-items="@(new SelectList(Model.Members, "Id", "FirstName"))">
                        <option value="">-- Select Member --</option>
                    </select>
                </div>

                <div class="d-flex justify-content-end">
                    <a asp-action="Index" class="btn btn-secondary me-2">Cancel</a>
                    <button type="submit" class="btn btn-primary"><i class="fas fa-bookmark me-1"></i> Reserve Book</button>
                </div>
            </form>
        </div>
    </div>
</div>