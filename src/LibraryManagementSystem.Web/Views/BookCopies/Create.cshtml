@model LibraryManagementSystem.Web.ViewModels.BookCopy.BookCopyFormViewModel
@using LibraryManagementSystem.Domain.Enums
@{
    ViewData["Title"] = "Add Book Copy";
}

<div class="container-fluid">
    <h1 class="h3 mb-4 text-gray-800">Add Book Copy</h1>

    <div class="card shadow mb-4">
        <div class="card-body">
            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                
                <div class="mb-3">
                    <label asp-for="BookId" class="form-label"></label>
                    <select asp-for="BookId" class="form-select" asp-items="@(new SelectList(Model.Books, "Id", "Title"))">
                        <option value="">-- Select Book --</option>
                    </select>
                    <span asp-validation-for="BookId" class="text-danger"></span>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="AccessionNumber" class="form-label"></label>
                        <input asp-for="AccessionNumber" class="form-control" />
                        <span asp-validation-for="AccessionNumber" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="Barcode" class="form-label"></label>
                        <input asp-for="Barcode" class="form-control" />
                        <span asp-validation-for="Barcode" class="text-danger"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Condition" class="form-label"></label>
                        <select asp-for="Condition" class="form-select" asp-items="Html.GetEnumSelectList<BookCondition>()"></select>
                        <span asp-validation-for="Condition" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="Status" class="form-label"></label>
                        <select asp-for="Status" class="form-select" asp-items="Html.GetEnumSelectList<BookCopyStatus>()"></select>
                        <span asp-validation-for="Status" class="text-danger"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label asp-for="PurchaseDate" class="form-label"></label>
                        <input asp-for="PurchaseDate" type="date" class="form-control" />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="Price" class="form-label"></label>
                        <input asp-for="Price" type="number" step="0.01" class="form-control" />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="ShelfLocation" class="form-label"></label>
                        <input asp-for="ShelfLocation" class="form-control" />
                    </div>
                </div>

                <div class="d-flex justify-content-end">
                    <a asp-action="Index" class="btn btn-secondary me-2">Cancel</a>
                    <button type="submit" class="btn btn-primary"><i class="fas fa-save me-1"></i> Add Copy</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}