@model LibraryManagementSystem.Web.ViewModels.BookCopy.BookCopyFormViewModel
@using LibraryManagementSystem.Domain.Enums
@{
    ViewData["Title"] = "Edit Book Copy";
}

<div class="container-fluid">
    <h1 class="h3 mb-4 text-gray-800">Edit Book Copy</h1>

    <div class="card shadow mb-4">
        <div class="card-body">
            <form asp-action="Edit" method="post">
                <input type="hidden" asp-for="Id" />
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                
                <div class="mb-3">
                    <label class="form-label">Book</label>
                    <input type="text" class="form-control" value="@Model.BookTitle" readonly />
                    <input type="hidden" asp-for="BookId" />
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="AccessionNumber" class="form-label"></label>
                        <input asp-for="AccessionNumber" class="form-control" />
                        <span asp-validation-for="AccessionNumber" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="Barcode" class="form-label"></label>
                        <input asp-for="Barcode" class="form-control" />
                        <span asp-validation-for="Barcode" class="text-danger"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Condition" class="form-label"></label>
                        <select asp-for="Condition" class="form-select" asp-items="Html.GetEnumSelectList<BookCondition>()"></select>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="Status" class="form-label"></label>
                        <select asp-for="Status" class="form-select" asp-items="Html.GetEnumSelectList<BookCopyStatus>()"></select>
                    </div>
                </div>

                <div class="d-flex justify-content-end">
                    <a asp-action="Index" class="btn btn-secondary me-2">Cancel</a>
                    <button type="submit" class="btn btn-primary"><i class="fas fa-save me-1"></i> Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}