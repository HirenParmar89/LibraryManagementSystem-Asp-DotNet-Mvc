@model LibraryManagementSystem.Web.ViewModels.Settings.SettingsViewModel
@{
    ViewData["Title"] = "System Settings";
}

<div class="container-fluid">
    <h1 class="h3 mb-4 text-gray-800">System Settings</h1>

    <div class="card shadow mb-4">
        <div class="card-body">
            <form asp-action="Index" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        @TempData["SuccessMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                <div class="table-responsive">
                    <table class="table table-borderless">
                        <thead class="thead-light">
                            <tr>
                                <th>Setting</th>
                                <th>Description</th>
                                <th>Value</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < Model.Settings.Count; i++)
                            {
                                <tr>
                                    <input type="hidden" asp-for="Settings[i].Id" />
                                    <input type="hidden" asp-for="Settings[i].Key" />
                                    <input type="hidden" asp-for="Settings[i].Description" />
                                    
                                    <td><strong>@Model.Settings[i].Key</strong></td>
                                    <td class="text-muted">@Model.Settings[i].Description</td>
                                    <td>
                                        <input asp-for="Settings[i].Value" class="form-control" style="min-width: 200px;" />
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="d-flex justify-content-end mt-4">
                    <button type="submit" class="btn btn-primary"><i class="fas fa-save me-1"></i> Save Settings</button>
                </div>
            </form>
        </div>
    </div>
    
    <div class="alert alert-info">
        <i class="fas fa-info-circle me-1"></i> Note: Settings are read from the database if available. If empty, default values from <code>appsettings.json</code> are shown but won't be saved until rows exist in the database.
    </div>
</div>