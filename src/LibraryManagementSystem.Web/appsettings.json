{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=LibraryManagementSystemDb;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/app-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "LibrarySettings": {
    "LibraryName": "Advanced Library Management System",
    "LibraryAddress": "123 Knowledge Blvd, Booktown",
    "LibraryPhone": "555-0198",
    "LibraryEmail": "info@library.com",
    "DefaultLoanDurationDays": 14,
    "MaxBooksPerMember": 5,
    "MaxRenewals": 2,
    "DailyFineAmount": 5.0,
    "FineGracePeriodDays": 0,
    "MembershipDurationMonths": 12,
    "CurrencySymbol": "₹",
    "BlockIssueOnFine": true
  },
  "EmailSettings": {
    "SmtpServer": "smtp.example.com",
    "SmtpPort": 587,
    "SenderName": "Library Admin",
    "SenderEmail": "no-reply@library.com",
    "SmtpUsername": "your_smtp_username",
    "SmtpPassword": "your_smtp_password",
    "UseSsl": true
  },
  "AllowedHosts": "*"
}